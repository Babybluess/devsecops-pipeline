{
  "name": "devsecops-pipeline-sample",
  "version": "1.0.0",
  "description": "Sample Node.js app demonstrating DevSecOps pipeline integration",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:cov": "jest --coverage",
    "security:sast": "semgrep --config .semgrep/custom-rules.yml --config p/owasp-top-ten .",
    "security:secrets": "detect-secrets scan --no-verify > .secrets.baseline",
    "security:deps": "npm audit --audit-level=high",
    "security:licenses": "license-checker --failOn 'GPL;AGPL;LGPL'",
    "security:all": "npm run security:sast && npm run security:secrets && npm run security:deps && npm run security:licenses"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "class-validator": "^0.14.0",
    "express": "^4.18.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
